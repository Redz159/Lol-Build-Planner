{"id":"Yuumi","stats":{"hp":500,"hpPerLevel":69,"hpRegen":0,"hpRegenPerLevel":0.11,"resourceType":0,"resource":440,"resourcePerLevel":45,"resourceRegen":2,"resourceRegenPerLevel":0.08,"ad":49,"adPerLevel":3.1,"armor":25,"armorPerLevel":4.2,"mr":25,"mrPerLevel":1.1,"attackSpeed":0.625,"attackSpeedRatio":0.625,"attackSpeedPerLevel":1,"moveSpeed":330,"range":425,"critDamageMultiplier":2,"adaptiveApWeight":1},"passive":{"scriptName":"YuumiP","name":"Feline Friendship","tooltip":"When Yuumi's Attacks and Abilities strike champions, she heals herself for <healing><health>@HealAmount@ health</health></healing>. If Yuumi <keywordMajor>Attaches</keywordMajor> to an ally within @HealDelayTime@ seconds, they are <heal>healed</heal> as well. This effect has a @PassiveCooldown@ second Cooldown.<br><br>While <keywordMajor>Attached</keywordMajor>, Yuumi gains <keywordMajor>Friendship</keywordMajor> with her ally whenever they kill a champion or minion. The ally with the most <keywordMajor>Friendship</keywordMajor> becomes her <keywordMajor>Best Friend</keywordMajor> and grants Yuumi bonus effects to her Abilities while she is <keywordMajor>Attached</keywordMajor> to them. <br><br><rules>The heal will automatically trigger if Yuumi is already Attached to an ally.</rules>","dataValues":{"TakedownCompanionship":[2,2,2,2,2,2,2],"HealDelayTime":[4,4,4,4,4,4,4],"MinionKillCompanionship":[2,2,2,2,2,2,2],"PityTimer":[6,6,6,6,6,6,6]},"calculations":{"PassiveCooldown":{"mFormulaParts":[{"mLevel1Value":20,"mInitialBonusPerLevel":-1,"mBreakpoints":[{"mLevel":14,"__type":"Breakpoint"}],"__type":"ByCharLevelBreakpointsCalculationPart"}],"__type":"GameCalculation"},"{656dde8a}":{"mFormulaParts":[{"mLevel1Value":50,"__type":"ByCharLevelBreakpointsCalculationPart"}],"__type":"GameCalculation"},"HealAmount":{"mFormulaParts":[{"mStartValue":20,"mEndValue":110,"__type":"ByCharLevelInterpolationCalculationPart"},{"mCoefficient":0.3,"__type":"StatByCoefficientCalculationPart"}],"__type":"GameCalculatio