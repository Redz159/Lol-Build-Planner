, dealing <magicDamage>@Tooltip_QEDamage@ magic damage</magicDamage> in an area and leaving behind pools of lava that <status>Slow</status> enemies by @spell.HweiQE:SlowPercent@% and deal <magicDamage>@Tooltip_QEDamagePerSecond@ magic damage per second</magicDamage> for @spell.HweiQE:Duration@ seconds.","dataValues":{"Tooltip_QQBaseDamage":[20,50,80,110,140,170,200],"Tooltip_QQBonusDamage":[2,3,4,5,6,7,8],"Tooltip_QWBaseDamage":[35,60,85,110,135,160,185],"Tooltip_QWBonusDamageMult":[1.625,2,2.375,2.75,3.125,3.5,3.875],"Tooltip_QEBaseDamage":[5,20,35,50,65,80,95],"Tooltip_QEBaseDPS":[5,20,35,50,65,80,95]},"calculations":{"Tooltip_QQDamage":{"tooltipOnly":true,"mFormulaParts":[{"mDataValue":"Tooltip_QQBaseDamage","__type":"NamedDataValueCalculationPart"},{"mCoefficient":0.8,"__type":"StatByCoefficientCalculationPart"}],"__type":"GameCalculation"},"Tooltip_QWDamage":{"tooltipOnly":true,"mFormulaParts":[{"mDataValue":"Tooltip_QWBaseDamage","__type":"NamedDataValueCalculationPart"},{"mCoefficient":0.3,"__type":"StatByCoefficientCalculationPart"}],"__type":"GameCalculation"},"Tooltip_QWBonusDamage":{"mMultiplier":{"mDataValue":"Tooltip_QWBonusDamageMult","__type":"NamedDataValueCalculationPart"},"tooltipOnly":true,"mModifiedGameCalculation":"Tooltip_QWDamage","__type":"GameCalculationModified"},"Tooltip_QEDamage":{"tooltipOnly":true,"mFormulaParts":[{"mDataValue":"Tooltip_QEBaseDamage","__type":"NamedDataValueCalculationPart"},{"mCoefficient":0.3,"__type":"StatByCoefficientCalculationPart"}],"__type":"GameCalculation"},"Tooltip_QEDamagePerSecond":{"tooltipOnly":true,"mFormulaParts":[{"mDataValue":"Tooltip_QEBaseDPS","__type":"NamedDataValueCalculationPart"},{"mCoefficient":0.24,"__type":"StatByCoefficientCalculationPart"}],"__type":"GameCalculation"}},"effectAmounts":[],"cooldown":[10,10,9,8,7,6,6],"cost":[80,90,100,110,120,120],"maxRank":5,"icon":"HweiQ.png"},{"scriptName":"HweiW","name":"Subject: Serenity","tooltip":"Hwei paints visions of serenity that provide utility 